# GESPlan prototype environment. Copy to .env.local and fill in only what you need;
# an empty value counts as unset. Restart `npm run dev` after a change.

# Module catalogue source: "static" reads the seed file in the repo (default, for development),
# "http" reads an HTTP endpoint with the contract described in README "Katalog".
CATALOG_SOURCE=static

# Base URL of the HTTP catalogue, used when CATALOG_SOURCE=http. A trailing slash is fine.
# For the local mock (npm run catalog:mock): http://localhost:4010
CATALOG_API_BASE_URL=

# API key for the HTTP catalogue, sent as "Authorization: Bearer <key>" from the server only.
# Never rename it with a NEXT_PUBLIC_ prefix: Next.js would then ship it to every browser.
CATALOG_API_KEY=

# Optional: a different seed file for the static source, relative to the project root.
# Default: data/catalog/kivanc-modules.json
CATALOG_SEED_PATH=

# Optional: catalogue id of the module new designs start with. Used only when that record has
# length, width and power; otherwise the usual default applies.
NEXT_PUBLIC_DEFAULT_MODULE_ID=
